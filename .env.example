# =====================================================================
# ApolloCare Smart Hospital AI Assistant — Environment Configuration
# =====================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8500
SECRET_KEY=change-me-to-a-secure-random-32-character-key

# RAG Configuration (Sliding window chunk size & overlap in characters)
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80

# ---------------------------------------------------------------------
# LLM Provider & Model Selection
# ---------------------------------------------------------------------
# Supported LLM_PROVIDER options:
# - "openrouter" (e.g. google/gemini-2.5-flash-lite, anthropic/claude-3-haiku, openai/gpt-4o-mini)
# - "gemini"     (e.g. gemini/gemini-1.5-flash, gemini/gemini-2.0-flash)
# - "groq"       (e.g. groq/llama-3.3-70b-versatile)
# - "openai"     (e.g. openai/gpt-4o-mini)
# - "anthropic"  (e.g. anthropic/claude-3-5-sonnet-20241022)
# - "deepseek"   (e.g. deepseek/deepseek-chat)
# - "xai"        (e.g. xai/grok-beta)

LLM_PROVIDER=openrouter
MODEL=google/gemini-2.5-flash-lite
API_KEY=your_api_key_here

# Provider-Specific Fallbacks (Optional):
# OPENROUTER_API_KEY=sk-or-v1-...
# GEMINI_API_KEY=AIzaSy...
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Real-Time Voice Agent Gemini Live Model (Native Audio In/Out)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
